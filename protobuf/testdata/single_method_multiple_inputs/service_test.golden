package testpkg

import (
	"testing"

	pbe2e_test_service "github.com/example/proto/user"
	"github.com/google/go-cmp/cmp"
)

func TestCreateUser(t *testing.T) {
	tests := []struct {
		name     string
		input    *pbe2e_test_service.E2ECreateUserRequest
		expected *pbe2e_test_service.E2ECreateUserResponse
	}{
		{
			name: "case_0",
			input: &pbe2e_test_service.E2ECreateUserRequest{
				Email:    "alice@example.com",
				Username: "alice",
			},
			expected: &pbe2e_test_service.E2ECreateUserResponse{
				Success: true,
				UserId:  "user_alice",
			},
		},
		{
			name: "case_1",
			input: &pbe2e_test_service.E2ECreateUserRequest{
				Email:    "bob@example.com",
				Username: "bob",
			},
			expected: &pbe2e_test_service.E2ECreateUserResponse{
				Success: true,
				UserId:  "user_bob",
			},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			actual, err := e2e_test_serviceClient.CreateUser(t.Context(), tt.input)
			if err != nil {
				t.Fatalf("RPC call failed: %v", err)
			}
			if diff := cmp.Diff(tt.expected, actual); diff != "" {
				t.Errorf("CreateUser mismatch (-expected +actual):\n%s", diff)
			}
		})
	}
}
